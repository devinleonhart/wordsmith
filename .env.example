# Discord Bot Configuration
# Get this from https://discord.com/developers/applications/
WORDSMITH_SECRET_KEY=your_discord_bot_token_here

# Discord application (client) ID and target guild ID.
# Optional — these default to the Wordsmith app/server if unset.
# WORDSMITH_CLIENT_ID=your_application_id
# WORDSMITH_GUILD_ID=your_guild_id

# SQLite database file path (optional — defaults to ./data/wordsmith.db)
DATABASE_PATH=./data/wordsmith.db

# Development Notes:
# 1. Create a Discord application at https://discord.com/developers/applications
# 2. Go to the "Bot" section and copy the token
# 3. Replace "your_discord_bot_token_here" with your actual bot token
# 4. Rename this file to .env (without .example)
# 5. Make sure to add your bot to a Discord server for testing
