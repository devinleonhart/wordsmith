{
  "name": "wordsmith-discord-bot",
  "version": "2.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "cmd": "ts-node --files ./scripts/cmd.ts",
    "register": "ts-node --files ./src/register.ts",
    "dev": "NODE_ENV=development nodemon",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "quality": "tsc --noEmit && pnpm lint && pnpm test",
    "quality:ci": "tsc --noEmit && pnpm lint && pnpm test:coverage",
    "start": "NODE_ENV=production node ./dist/index.js",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fuzzy-dice": "^2.0.0",
    "pokenode-ts": "^2.3.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
